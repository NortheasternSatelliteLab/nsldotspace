---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PageIntro, Section, ContactForm, MailingListForm, contactEmail, socialLinks } from '../components';
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Northeastern Satellite Lab, join the mailing list, or find us on social."
>
  <PageIntro title="Contact">
    <span class="block">
      <strong class="text-white">NU student?</strong> Attend one of our <a href="/this-semester">meeting times</a> or
      join the NSL Discord server, available on the NU Student Hub on Discord.
    </span>
    <span class="mt-4 block">
      <strong class="text-white">Researcher, collaborator, press, or recruiter?</strong> Please email us
      at <a href={`mailto:${contactEmail}`} class="[overflow-wrap:anywhere]">{contactEmail}</a> or use the form below.
    </span>
    <span class="mt-4 block">
      We’re also on{' '}
      {socialLinks.map(({ href, label }, i) => (
        <>{i > 0 && ' and '}<a href={href}>{label}</a></>
      ))}.
    </span>
  </PageIntro>

  <Section title="Send a message" sub="The form opens your email app with the message filled in.">
    <ContactForm />
  </Section>

  <Section
    id="mailing"
    title="Mailing list"
    sub="Meeting times, launch news, and ways to get involved, for Northeastern students and the NSL community."
  >
    <MailingListForm />
    <p class="mt-4 text-sm text-slate">Project mailing lists for TeraLink-1 and the THz ground station are coming soon.</p>
  </Section>
</BaseLayout>
