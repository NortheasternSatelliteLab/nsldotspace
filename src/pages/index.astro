---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import hero from '../assets/photos/proves/people-proves.png';
import provesWork from '../assets/photos/proves/proves-work.png';
import { Section, Org, OrgList, MailingListForm, Figure, TeraLinkLinks, CassegrainDish, DewsatSwath } from '../components';
import { teams } from '../components/site/teams';
import AlumniEmployers from '../partials/alumni-employers.mdx';

const work = [
  {
    href: '/projects/proves-atlas',
    name: 'PROVES Atlas',
    status: 'In orbit since April 2026',
    what: 'Our first satellite. A camera CubeSat, built by about 15 students in under a year and deployed from the ISS with four other university satellites.',
    photo: provesWork,
  },
  {
    href: '/projects/teralink-1',
    name: 'TeraLink-1',
    status: 'Critical Design Review in November',
    what: 'A 6U CubeSat that will try the first terahertz link from space to the ground. Funded by AFRL’s University Nanosatellite Program.',
    Diagram: TeraLinkLinks,
  },
  {
    href: '/projects/sub-thz',
    name: 'Sub-THz Ground Station',
    status: 'System Requirements Review',
    what: 'The other end of that link: a 2 m reflector dish that must hold its shape to within 83 µm.',
    Diagram: CassegrainDish,
  },
  {
    href: '/projects/dewsat',
    name: 'DEWSat',
    status: 'NASA Space to Soil finalist',
    what: 'A drought early-warning satellite that scores farmland for drought risk in orbit and sends down only the high-risk images.',
    Diagram: DewsatSwath,
  },
];

const press = [
  {
    title: 'Students reach for the stars with launch of first satellite',
    outlet: 'Northeastern Global News, March 2026',
    href: 'https://news.northeastern.edu/2026/03/20/student-club-satellite-launch/',
  },
  {
    title: 'Northeastern Satellite Laboratory prepares for interstellar debut with cube satellite',
    outlet: 'The Huntington News, April 2026',
    href: 'https://huntnewsnu.com/92573/primary-homepage/northeastern-satellite-laboratory-prepares-for-interstellar-debut-with-cube-satellite/',
  },
  {
    title: 'New Space Engineering Club Set to Launch Their First Satellite',
    outlet: 'Northeastern College of Engineering, March 2026',
    href: 'https://coe.northeastern.edu/news/new-space-engineering-club-set-to-launch-their-first-satellite/',
  },
  {
    title: 'Building a space satellite isn’t cheap. These Northeastern students are researching ways to bring the cost way down.',
    outlet: 'Northeastern Global News, September 2024',
    href: 'https://news.northeastern.edu/2024/09/16/satellite-development-cost-project-horizon/',
  },
  {
    title: 'Student Club Is Innovating To Lower the Cost of Satellites',
    outlet: 'Northeastern College of Engineering, September 2024',
    href: 'https://coe.northeastern.edu/news/northeastern-undergraduates-innovate-satellite-development-through-project-horizon/',
  },
];
---

<BaseLayout>
  <section class="mx-auto w-full max-w-6xl px-5 pt-14 pb-14 sm:pt-20 sm:pb-20">
    <h1 class="font-display text-[clamp(2.25rem,7vw,4rem)] leading-none font-medium text-white font-features-['smcp']">
      Northeastern <span class="text-clay">Satellite</span> Lab
    </h1>
    <div class="mt-8 grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-14">
      <div class="prose-nsl text-lg text-alice/90">
        <p>
          We’re a student club at Northeastern University that designs, builds, and launches small satellites. In
          April 2026 our first one, <a href="/projects/proves-atlas">PROVES Atlas</a>, was deployed from the
          International Space Station. The next, <a href="/projects/teralink-1">TeraLink-1</a>, is on the bench now.
        </p>
        <p>
          You don’t need experience to join. New members start at Intro to Satellites, Mondays at 7 PM in Forsyth 129.
          The rest of the week’s meetings are on the <a href="/this-semester">schedule</a>.
        </p>
      </div>
      <a href="#mailing" class="btn-primary justify-self-start">Join the mailing list <ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>
    <figure class="mt-12 sm:mt-14">
      <Image
        src={hero}
        alt="Five club members look up at the camera from around a table covered in CubeSat boards and tools"
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1152px) 1112px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[3/2] w-full rounded-sm object-cover object-[50%_35%] sm:aspect-[21/9]"
      />
      <figcaption class="mt-2 text-sm text-slate">Members of the PROVES Atlas team with the satellite's boards and flight hardware. Photo: Margot Murphy/The Huntington News.</figcaption>
    </figure>
  </section>

  <Section title="What we’re working on">
    <ul class="grid gap-x-10 gap-y-12 md:grid-cols-2">
      {work.map(({ href, name, status, what, photo, Diagram }) => (
        <li>
          <Figure>
            {photo && (
              <Image
                src={photo}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 768px) 420px, 100vw"
                class="block aspect-[32/19] h-auto w-full object-cover"
              />
            )}
            {Diagram && <Diagram />}
          </Figure>
          <h3 class="mt-4 font-semibold">
            <a href={href} class="text-white decoration-white/30 hover:text-clay hover:decoration-clay">{name}</a>
          </h3>
          <p class="text-sm text-clay">{status}</p>
          <p class="mt-2 text-pretty text-alice/80">{what}</p>
        </li>
      ))}
    </ul>
    <p class="mt-12 max-w-3xl border-t border-line pt-5 text-alice/80">
      We also help the MIT Satellite Team with <a href="/projects#core">LEONIRD</a>, and run open-source projects
      like a star tracker and a mission simulator. <a href="/projects">All projects</a>.
    </p>
  </Section>

  <Section title="How the club works">
    <div class="prose-nsl text-alice/90">
      <p>Every member joins one of four teams, each with its own weekly meeting:</p>
      <ul class="space-y-2">
        {teams.map(({ name, what, Icon }) => (
          <li class="flex gap-3">
            <Icon class="mt-1 size-5 shrink-0 text-clay" aria-hidden="true" />
            <span><span class="text-white">{name}</span>: {what}</span>
          </li>
        ))}
      </ul>
      <p>
        The Business team finds and writes the competition entries and grant proposals that pay for the hardware.
        The club started in 2020 as Project Horizon inside AeroNU and became its own club in Spring 2026. Our faculty
        advisor is Dr. Josep Jornet. <a href="/about">More about us</a>.
      </p>
    </div>
  </Section>

  <Section title="Quick facts">
    <dl class="grid max-w-3xl gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['4', 'teams'],
        ['2', 'space missions'],
        ['3+', 'research grants won'],
        ['20+', 'members per semester'],
      ].map(([big, label]) => (
        <div class="border-t border-line pt-3">
          <dt class="text-sm text-slate">{label}</dt>
          <dd class="font-display text-3xl text-white">{big}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section title="Who we work with">
    <div class="space-y-4">
      <OrgList label="Partners and mentors:">
        <Org>NASA’s CubeSat Launch Initiative</Org>
        <Org>AFRL’s University Nanosatellite Program</Org>
        <Org>Northeastern’s Institute for Intelligent Network Systems</Org>
        <Org>UNLab</Org>
        <Org>NSF CIRC</Org>
        <Org>PROVES</Org>
        <Org>Cal Poly Pomona Bronco Space</Org>
        <Org>the MIT Satellite Team</Org>
        <Org>Morehead State University</Org>
      </OrgList>
      <OrgList label="Members and alumni have gone on to:"><AlumniEmployers /></OrgList>
    </div>
  </Section>

  <Section title="In the news">
    <ul class="max-w-3xl space-y-4">
      {press.map(({ title, outlet, href }) => (
        <li>
          <a href={href}>{title}<ArrowUpRight class="ml-1 inline size-4 align-[-0.125em]" aria-hidden="true" /></a>
          <span class="block text-sm text-slate">{outlet}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section
    id="mailing"
    title="Mailing list"
    sub="Meeting times, launch news, and ways to get involved, for Northeastern students and the NSL community."
  >
    <MailingListForm />
  </Section>
</BaseLayout>
