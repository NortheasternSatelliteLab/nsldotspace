---
// Like the mailing-list form, this opens a pre-filled email rather than posting to a backend.
import { contactEmail } from '../site/links';

const label = 'block text-alice';
const field = 'mt-2 block w-full rounded-sm border border-dusk bg-ink px-4 py-3 text-white placeholder:text-slate/60 focus:border-clay focus:outline-none';
---

<form data-contact-form data-user={contactEmail.user} data-domain={contactEmail.domain} class="max-w-xl space-y-5">
  <div>
    <label for="contact-name" class={label}>Name</label>
    <input id="contact-name" name="name" type="text" required autocomplete="name" placeholder="Your name" class={field} />
  </div>
  <div>
    <label for="contact-email" class={label}>Email</label>
    <input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class={field} />
  </div>
  <div>
    <label for="contact-message" class={label}>Message</label>
    <textarea id="contact-message" name="message" required rows="5" placeholder="What’s on your mind?" class={field}></textarea>
  </div>
  <button type="submit" class="btn-primary">
    Send message
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('message')}`);
    window.location.href = `mailto:${form.dataset.user}@${form.dataset.domain}?subject=Inquiry%20from%20website&body=${body}`;
  });
</script>
